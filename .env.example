# ── Required ────────────────────────────────────────────────────────────────

# Your license key, emailed to you when you purchased FreshGen Link.
# Looks like: 85DE7B55-4A6E4E5A-8E5A0FDF-1BE4E0FC
# Without it, image and video generation stay disabled.
LICENSE_KEY=

# Your Kie.ai API key. Get it at https://kie.ai/api-key
# Pay-as-you-go credits: 1 credit = $0.005. Images from ~$0.02, video from ~$0.25.
KIE_API_KEY=

# A long random secret (30+ characters — mash the keyboard or use a password
# generator). It becomes part of your private URL:
#   https://your-app.vercel.app/mcp/<MCP_SECRET>
# Treat that URL like a password.
MCP_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# White-label: the name shown on the landing page, dashboard, and inside GHL.
# Leave unset for the default "FreshGen".
BRAND_NAME=

# GoHighLevel Private Integration Token. Setting this, PLUS a location
# (either GHL_LOCATION_ID below or a per-request /mcp/<secret>/<locationId>
# URL), enables the save_to_media_library tool and auto-save, which copy
# generated media into a GHL Media Library so it never expires. Create a PIT
# in GHL: Settings → Private Integrations → New (needs the "View/Edit Media"
# scopes). Managing multiple sub-accounts? Use an agency-level PIT (Agency
# Settings → Private Integrations) so it covers all of them — see the README's
# "Multiple sub-accounts (agencies)" section.
GHL_PIT=

# The DEFAULT GHL location (sub-account) generated media gets saved into when
# a request doesn't specify one via a per-location URL. Optional if you only
# ever use per-location URLs.
GHL_LOCATION_ID=
