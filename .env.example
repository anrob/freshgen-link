# ── Required ────────────────────────────────────────────────────────────────

# Your license key, emailed to you when you got FreshGen Link (Lite or Full).
# Looks like: 85DE7B55-4A6E4E5A-8E5A0FDF-1BE4E0FC
# The key decides the edition: Lite = images on GPT Image 2 only · Full = every
# model + video. Upgrading is just pasting the new key here and redeploying.
# Without it, image and video generation stay disabled.
LICENSE_KEY=

# Your Kie.ai API key. Get it at https://kie.ai/api-key
# Pay-as-you-go credits: 1 credit = $0.005. Images from ~$0.02, video from ~$0.25.
KIE_API_KEY=

# A long random secret (30+ characters — mash the keyboard or use a password
# generator). It becomes part of your private URL:
#   https://your-app.vercel.app/mcp/<MCP_SECRET>
# Treat that URL like a password.
MCP_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# GoHighLevel Private Integration Token. Setting this, PLUS GHL_LOCATION_ID
# below, enables the save_to_media_library tool and auto-save, which copy
# generated media into your GHL Media Library so it never expires. Create a
# PIT in GHL: Settings → Private Integrations → New (needs the "View/Edit
# Media" scopes).
GHL_PIT=

# The GHL location (sub-account) generated media gets saved into.
GHL_LOCATION_ID=
