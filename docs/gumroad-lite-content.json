    "description": {
      "type": "doc",
      "content": [
        { "type": "licenseKey" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "Your license key is at the top of this page and in your receipt email. You'll paste it in during setup — keep it somewhere safe. This is a Lite key: images on GPT Image 2. If you upgrade to Full later, you just swap the key." } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "STEP 1 — Deploy it" } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "Click the deploy button in the README: " }, { "type": "tiptap-link", "attrs": { "href": "https://github.com/anrob/freshgen-link" }, "content": [ { "type": "text", "text": "https://github.com/anrob/freshgen-link" } ] } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "It copies the project into your own GitHub and deploys it to your own Vercel account. Vercel will ask you for three values:" } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "LICENSE_KEY — the key at the top of this page" } ] },
        { "type": "paragraph", "content": [ { "type": "text", "text": "KIE_API_KEY — your key from " }, { "type": "tiptap-link", "attrs": { "href": "https://kie.ai/api-key" }, "content": [ { "type": "text", "text": "https://kie.ai/api-key" } ] } ] },
        { "type": "paragraph", "content": [ { "type": "text", "text": "MCP_SECRET — 30+ random characters you make up (mash the keyboard)" } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "Build takes about three minutes." } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "STEP 2 — Check it works" } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "Open your private dashboard: " } ] },
        { "type": "paragraph", "content": [ { "type": "text", "text": "https://YOUR-APP.vercel.app/s/YOUR-MCP-SECRET" } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "You'll see your " }, { "type": "tiptap-link", "attrs": { "href": "https://kie.ai" }, "content": [ { "type": "text", "text": "Kie.ai" } ] }, { "type": "text", "text": " balance and a test-image button. Hit it. If an image comes back, everything's wired up." } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "STEP 3 — Connect it to GoHighLevel" } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "In GHL: Ask AI → the + icon → Manage Connectors → + Add custom MCP. Name it whatever you like, paste your MCP URL from the dashboard, click Add MCP. Then ask your agent for an image." } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "Using an Agent Studio Superagent? Use the instant-mode URL from your dashboard (it's your normal URL with ?mode=instant on the end)." } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "WANT VIDEO, MORE MODELS, EVERY SUB-ACCOUNT, YOUR OWN BRAND?" } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "That's Full ($47, one-time): " }, { "type": "tiptap-link", "attrs": { "href": "https://iamjustfresh.gumroad.com/l/freshgen-link" }, "content": [ { "type": "text", "text": "https://iamjustfresh.gumroad.com/l/freshgen-link" } ] }, { "type": "text", "text": ". Paste the new key into LICENSE_KEY, redeploy, and the extra tools show up in GHL on their own." } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "Full docs, including Workflow AI Agents and Agent Studio setup, are in the README and docs/GHL-SETUP.md." } ] },
        { "type": "paragraph" },
        { "type": "paragraph", "content": [ { "type": "text", "text": "Something broken? Reply to your receipt email and I'll sort it out." } ] }
      ]
    }
  }
]
